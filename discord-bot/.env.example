# Discord Developer Portal で取得したBotトークン
DISCORD_TOKEN=your_bot_token_here

# 開発中にスラッシュコマンドを即時反映させたい場合、テストサーバーのIDを指定
# 空欄の場合はグローバル同期（反映まで最大1時間程度かかることがあります）
GUILD_ID=

# Disboardのbot ID（通常は変更不要）
DISBOARD_BOT_ID=302050872383242240

# /up-mantion で監視する「アップ系」bot のID
# 例: ディス速(Dissoku) など。ご自身のサーバーで実際に使っているbotのIDに
# 必ず書き換えて確認してください（間違っていると検知されません）
UP_BOT_ID=761562078095867916
